{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Step 3: Baduk Domain Knowledge Construction",
  "type": "object",
  "required": ["step", "output_files", "verification"],
  "properties": {
    "step": { "const": 3 },
    "output_files": {
      "type": "object",
      "required": ["knowledge_yaml", "rules_spec", "rules_spec_ko"],
      "properties": {
        "knowledge_yaml": { "type": "string", "pattern": "^outputs/step-03-.*\\.yaml$" },
        "rules_spec": { "type": "string", "pattern": "^outputs/step-03-.*\\.md$" },
        "rules_spec_ko": { "type": "string", "pattern": "^outputs/step-03-.*\\.ko\\.md$" }
      }
    },
    "verification": {
      "type": "object",
      "required": ["tromp_taylor_10_rules", "entity_count", "relation_count", "constraint_count", "edge_cases_count", "chinese_scoring_specified", "board_representation_designed"],
      "properties": {
        "tromp_taylor_10_rules": { "type": "boolean" },
        "entity_count": { "type": "integer", "minimum": 50 },
        "relation_count": { "type": "integer", "minimum": 30 },
        "constraint_count": { "type": "integer", "minimum": 20 },
        "edge_cases_count": { "type": "integer", "minimum": 15 },
        "chinese_scoring_specified": { "type": "boolean" },
        "board_representation_designed": { "type": "boolean" }
      }
    },
    "pacs": { "$ref": "#/$defs/pacs" },
    "review": { "$ref": "#/$defs/review_result" }
  },
  "$defs": {
    "pacs": {
      "type": "object",
      "required": ["F", "C", "L", "score"],
      "properties": {
        "F": { "type": "integer", "minimum": 0, "maximum": 100 },
        "C": { "type": "integer", "minimum": 0, "maximum": 100 },
        "L": { "type": "integer", "minimum": 0, "maximum": 100 },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "review_result": {
      "type": "object",
      "required": ["reviewer", "verdict"],
      "properties": {
        "reviewer": { "type": "string" },
        "verdict": { "type": "string", "enum": ["PASS", "FAIL"] }
      }
    }
  }
}
