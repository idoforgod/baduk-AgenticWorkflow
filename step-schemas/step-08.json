{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Step 8: Test Strategy & Parallel Execution Plan",
  "type": "object",
  "required": ["step", "output_files", "verification"],
  "properties": {
    "step": { "const": 8 },
    "output_files": {
      "type": "object",
      "required": ["test_strategy", "parallel_plan", "test_strategy_ko"],
      "properties": {
        "test_strategy": { "type": "string", "pattern": "^outputs/step-08-.*\\.md$" },
        "parallel_plan": { "type": "string", "pattern": "^outputs/step-08-.*\\.md$" },
        "test_strategy_ko": { "type": "string", "pattern": "^outputs/step-08-.*\\.ko\\.md$" }
      }
    },
    "verification": {
      "type": "object",
      "required": ["tdd_plan_per_module", "rules_test_count", "katago_oracle_defined", "e2e_scenario_count", "branch_strategy_defined", "integration_schedule_defined"],
      "properties": {
        "tdd_plan_per_module": { "type": "boolean" },
        "rules_test_count": { "type": "integer", "minimum": 130 },
        "katago_oracle_defined": { "type": "boolean" },
        "e2e_scenario_count": { "type": "integer", "minimum": 10 },
        "branch_strategy_defined": { "type": "boolean" },
        "integration_schedule_defined": { "type": "boolean" }
      }
    },
    "pacs": { "$ref": "#/$defs/pacs" },
    "review": { "$ref": "#/$defs/review_result" }
  },
  "$defs": {
    "pacs": {
      "type": "object",
      "required": ["F", "C", "L", "score"],
      "properties": {
        "F": { "type": "integer", "minimum": 0, "maximum": 100 },
        "C": { "type": "integer", "minimum": 0, "maximum": 100 },
        "L": { "type": "integer", "minimum": 0, "maximum": 100 },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "review_result": {
      "type": "object",
      "required": ["reviewer", "verdict"],
      "properties": {
        "reviewer": { "type": "string" },
        "verdict": { "type": "string", "enum": ["PASS", "FAIL"] }
      }
    }
  }
}
