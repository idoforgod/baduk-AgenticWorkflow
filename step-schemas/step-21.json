{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Step 21: Integration Testing & Hardening",
  "type": "object",
  "required": ["step", "verification"],
  "properties": {
    "step": { "const": 21 },
    "verification": {
      "type": "object",
      "required": ["e2e_count", "performance_profile", "cross_platform_3os", "quality_gates", "security_audit"],
      "properties": {
        "e2e_count": { "type": "integer", "minimum": 10 },
        "performance_profile": { "type": "boolean" },
        "cross_platform_3os": { "type": "boolean" },
        "quality_gates": { "type": "boolean" },
        "security_audit": { "type": "boolean" }
      }
    },
    "pacs": { "$ref": "#/$defs/pacs" },
    "review": { "$ref": "#/$defs/review_result" }
  },
  "$defs": {
    "pacs": {
      "type": "object",
      "required": ["F", "C", "L", "score"],
      "properties": {
        "F": { "type": "integer", "minimum": 0, "maximum": 100 },
        "C": { "type": "integer", "minimum": 0, "maximum": 100 },
        "L": { "type": "integer", "minimum": 0, "maximum": 100 },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "review_result": {
      "type": "object",
      "required": ["reviewer", "verdict"],
      "properties": {
        "reviewer": { "type": "string" },
        "verdict": { "type": "string", "enum": ["PASS", "FAIL"] }
      }
    }
  }
}
