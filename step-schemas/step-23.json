{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Step 23: M3 Features — Onboarding & Gamification",
  "type": "object",
  "required": ["step", "verification"],
  "properties": {
    "step": { "const": 23 },
    "type": { "const": "team_step" },
    "team": { "const": "m3-features" },
    "verification": {
      "type": "object",
      "required": ["onboarding_5min", "gamification_full", "performance_targets", "anonymous_first", "local_sqlite_storage"],
      "properties": {
        "onboarding_5min": { "type": "boolean" },
        "gamification_full": { "type": "boolean" },
        "performance_targets": { "type": "boolean" },
        "anonymous_first": { "type": "boolean" },
        "local_sqlite_storage": { "type": "boolean" }
      }
    },
    "pacs": { "$ref": "#/$defs/pacs" },
    "review": { "$ref": "#/$defs/review_result" }
  },
  "$defs": {
    "pacs": {
      "type": "object",
      "required": ["F", "C", "L", "score"],
      "properties": {
        "F": { "type": "integer", "minimum": 0, "maximum": 100 },
        "C": { "type": "integer", "minimum": 0, "maximum": 100 },
        "L": { "type": "integer", "minimum": 0, "maximum": 100 },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "review_result": {
      "type": "object",
      "required": ["reviewer", "verdict"],
      "properties": {
        "reviewer": { "type": "string" },
        "verdict": { "type": "string", "enum": ["PASS", "FAIL"] }
      }
    }
  }
}
